Cell["\<\
I then adapted this code to make it generate any word the user inputs. it \
applies the transformations defined above in the letters variable to each \
letter in the inputted word. Just change the word variable!\
\>", "Text",
 CellChangeTimes->{{3.981099421431437*^9, 3.981099474616454*^9}, {
  3.981109504385198*^9, 
  3.981109535414031*^9}},ExpressionUUID->"06c56b8d-88fb-4762-b7e5-\
95bddf1efbc9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"word", ":=", "\"\<hello\>\""}], "\[IndentingNewLine]", 
 RowBox[{"chars", ":=", 
  RowBox[{"Map", "[", 
   RowBox[{"LetterNumber", ",", 
    RowBox[{"Characters", "[", "word", "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"len", ":=", 
  RowBox[{"StringLength", "[", "word", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"width", ":=", 
  RowBox[{
   RowBox[{"5", "*", "len"}], "-", "1"}]}], "\[IndentingNewLine]", 
 RowBox[{"Fractal", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"List", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "/", "width"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
