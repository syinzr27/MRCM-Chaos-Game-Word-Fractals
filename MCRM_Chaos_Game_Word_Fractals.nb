Notebook[{

Cell[CellGroupData[{
Cell["Sophia\[CloseCurlyQuote]s MCRM Chaos Game Code!", "Title",
 CellChangeTimes->{{3.9810988299509277`*^9, 
  3.981098846594139*^9}},ExpressionUUID->"41117637-68cc-4bd1-bdc4-\
046b28d50e0f"],

Cell["\<\
Here\[CloseCurlyQuote]s the fractal function! It takes in 4 parameters:
- k is the list containing the scaling matrix for each vertex
- tf contains the transformation matrices (like rotation or reflection)
- tl contains the translation matrices
- n is a single positive integer, the number of iterations performed. The \
default value is 50000\
\>", "Text",
 CellChangeTimes->{{3.98109890850692*^9, 3.9810990847285233`*^9}, {
  3.9810993942976933`*^9, 
  3.981099400545353*^9}},ExpressionUUID->"5b7f29b4-d568-4590-ae6a-\
baa57b30adb2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Fractal", "[", 
   RowBox[{"k_", ",", "tf_", ",", "tl_", ",", 
    RowBox[{"n_", ":", "50000"}]}], "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RandomReal", "[", "]"}], ",", 
       RowBox[{"RandomReal", "[", "]"}]}], "}"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"allPoints", "=", 
     RowBox[{"{", "p", "}"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"i", "=", "1"}], ",", 
      RowBox[{"i", "<=", "n"}], ",", 
      RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{"RandomInteger", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"Length", "[", "k", "]"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"p", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"tf", "[", 
           RowBox[{"[", "r", "]"}], "]"}], ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"k", "[", 
             RowBox[{"[", "r", "]"}], "]"}], ".", "p"}], ")"}]}], "+", 
         RowBox[{"tl", "[", 
          RowBox[{"[", "r", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"allPoints", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"allPoints", ",", "p"}], "]"}]}]}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"allPoints", ",", 
      RowBox[{"AspectRatio", "->", "Automatic"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"PointSize", "[", "0.001", "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", ")"}]}]], "Input",
 CellChangeTimes->{{3.981105955888701*^9, 3.981105983450725*^9}, {
  3.981106837308502*^9, 3.981106838368493*^9}, {3.9811069797810087`*^9, 
  3.981106980734426*^9}},
 CellLabel->"In[94]:=",ExpressionUUID->"4934b823-d977-4be1-b11b-627a8f3e561f"],

Cell["Here\[CloseCurlyQuote]s an example using a familiar fractal from \
class!", "Text",
 CellChangeTimes->{{3.981099181895699*^9, 
  3.981099192157454*^9}},ExpressionUUID->"bd7220b3-18ee-4351-9dad-\
7bf9aec19f9a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Fractal", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
