Cell["\<\
Calculating the fractal dimension for this example \
(\[OpenCurlyDoubleQuote]hello\[CloseCurlyDoubleQuote]):
The fractal has lots of different scale and stretch factors, so it is \
difficult to directly calculate the dimension. I\[CloseCurlyQuote]ll \
approximate it using the box method instead.
Let rf be the dimension of the gridlines. I will draw gridlines and count the \
number of boxes with the border within them, then use a line of best fit to \
approximate the dimension.\
\>", "Text",
 CellChangeTimes->{{3.981099541899605*^9, 3.981099545686574*^9}, {
  3.981099652496901*^9, 3.981099667979106*^9}, {3.9811019493180323`*^9, 
  3.981101981384506*^9}, {3.9811020406644773`*^9, 3.981102066440654*^9}, {
  3.981107455716351*^9, 3.98110749651832*^9}, {3.981107695507125*^9, 
  3.9811077715724277`*^9}},ExpressionUUID->"070fec50-41fd-42d5-a16d-\
71220fcccc4a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"rf", ":=", "24"}], "\[IndentingNewLine]", 
 RowBox[{"word", ":=", "\"\<hello\>\""}], "\[IndentingNewLine]", 
 RowBox[{"chars", ":=", 
  RowBox[{"Map", "[", 
   RowBox[{"LetterNumber", ",", 
    RowBox[{"Characters", "[", "word", "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"len", ":=", 
  RowBox[{"StringLength", "[", "word", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"width", ":=", 
  RowBox[{
   RowBox[{"5", "*", "len"}], "-", "1"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Fractal", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"List", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "/", "width"}], ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"1", "/", "6"}]}], "}"}]}], "]"}], "&"}], ",", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"letters", "[", 
             RowBox[{"[", 
              RowBox[{"chars", "[", 
               RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "&"}], ",", "len"}], "]"}], 
        "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"R", "[", "#", "]"}], "&"}], ",", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Array", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"letters", "[", 
             RowBox[{"[", 
              RowBox[{"chars", "[", 
               RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "&"}], ",", "len"}], "]"}], 
        "]"}]}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Array", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"letters", "[", 
             RowBox[{"[", 
              RowBox[{"chars", "[", 
               RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}], "[", 
            RowBox[{"[", "3", "]"}], "]"}], "+", 
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"-", "width"}], "/", "2"}], "-", "3", "+", 
                RowBox[{"5", "#"}]}], ",", "0"}], "}"}], ",", 
             RowBox[{"Length", "[", 
              RowBox[{
               RowBox[{"letters", "[", 
                RowBox[{"[", 
                 RowBox[{"chars", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}], "[", 
               RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "]"}]}], "&"}], ",", 
         "len"}], "]"}], ",", "1"}], "]"}], ",", "\[IndentingNewLine]", 
     "100000"}], "\[IndentingNewLine]", "]"}], ",", 
   RowBox[{"GridLines", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "width"}], "/", "2"}], ",", 
        RowBox[{"width", "/", "2"}], ",", 
        RowBox[{"width", "/", "rf"}]}], "]"}], ",", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"-", "3"}], ",", "3", ",", 
        RowBox[{"6", "/", "rf"}]}], "]"}]}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.981107501480592*^9, 3.981107535089198*^9}, {
   3.981107626409881*^9, 3.9811076575412188`*^9}, {3.98110786838614*^9, 
