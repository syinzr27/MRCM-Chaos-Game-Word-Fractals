       RowBox[{"x", "*", "Degree"}], "]"}], ",", 
      RowBox[{"Cos", "[", 
       RowBox[{"x", "*", "Degree"}], "]"}]}], "}"}]}], 
   "}"}]}], "\[IndentingNewLine]", 
