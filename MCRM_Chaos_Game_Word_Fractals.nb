Cell["Thus, the fractal dimension is approximately 0.6567.", "Text",
 CellChangeTimes->{{3.9811083184160643`*^9, 
  3.981108339716913*^9}},ExpressionUUID->"1d7567d3-866b-451d-9f97-\
eeda9b203f48"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"word", ":=", "\"\<thanks\>\""}], "\[IndentingNewLine]", 
 RowBox[{"chars", ":=", 
  RowBox[{"Map", "[", 
   RowBox[{"LetterNumber", ",", 
    RowBox[{"Characters", "[", "word", "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"len", ":=", 
  RowBox[{"StringLength", "[", "word", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"width", ":=", 
  RowBox[{
   RowBox[{"5", "*", "len"}], "-", "1"}]}], "\[IndentingNewLine]", 
 RowBox[{"Fractal", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"List", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "/", "width"}], ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"1", "/", "6"}]}], "}"}]}], "]"}], "&"}], ",", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Array", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"letters", "[", 
           RowBox[{"[", 
            RowBox[{"chars", "[", 
             RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "&"}], ",", "len"}], "]"}], "]"}]}],
     "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"R", "[", "#", "]"}], "&"}], ",", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Array", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"letters", "[", 
           RowBox[{"[", 
            RowBox[{"chars", "[", 
             RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], "&"}], ",", "len"}], "]"}], "]"}]}],
     "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"letters", "[", 
           RowBox[{"[", 
            RowBox[{"chars", "[", 
             RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}], "[", 
          RowBox[{"[", "3", "]"}], "]"}], "+", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"-", "width"}], "/", "2"}], "-", "3", "+", 
              RowBox[{"5", "#"}]}], ",", "0"}], "}"}], ",", 
           RowBox[{"Length", "[", 
            RowBox[{
             RowBox[{"letters", "[", 
              RowBox[{"[", 
               RowBox[{"chars", "[", 
                RowBox[{"[", "#", "]"}], "]"}], "]"}], "]"}], "[", 
             RowBox[{"[", "3", "]"}], "]"}], "]"}]}], "]"}]}], "&"}], ",", 
       "len"}], "]"}], ",", "1"}], "]"}], ",", "\[IndentingNewLine]", 
   "100000"}], "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.9811083595107822`*^9, 3.98110835989845*^9}, {
